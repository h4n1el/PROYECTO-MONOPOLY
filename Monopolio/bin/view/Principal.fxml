<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="750.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Principal">
   <children>
      <Label layoutX="300.0" layoutY="15.0" text="Sistema de Cuentas Bancarias">
         <font>
            <Font size="20.0" />
         </font>
      </Label>

      <!-- Formulario de registro -->
      <Label layoutX="30.0" layoutY="60.0" text="Titular" />
      <TextField fx:id="txtTitular" layoutX="30.0" layoutY="80.0" prefWidth="180.0" />

      <Label layoutX="230.0" layoutY="60.0" text="Documento" />
      <TextField fx:id="txtDocumento" layoutX="230.0" layoutY="80.0" prefWidth="150.0" />

      <Label layoutX="400.0" layoutY="60.0" text="Saldo Inicial" />
      <TextField fx:id="txtSaldoInicial" layoutX="400.0" layoutY="80.0" prefWidth="120.0" />

      <Label layoutX="540.0" layoutY="60.0" text="Tipo de Cuenta" />
      <ComboBox fx:id="cmbTipoCuenta" layoutX="540.0" layoutY="80.0" prefWidth="160.0" promptText="Seleccione" />

      <Button fx:id="btnRegistrar" layoutX="720.0" layoutY="80.0" mnemonicParsing="false" onAction="#registrarCuenta" prefWidth="150.0" text="Registrar Cuenta" />

      <!-- Formulario de operaciones -->
      <Label layoutX="30.0" layoutY="130.0" text="Monto de Operación" />
      <TextField fx:id="txtMonto" layoutX="30.0" layoutY="150.0" prefWidth="150.0" />

      <Label layoutX="200.0" layoutY="130.0" text="Cuenta Destino (Transferencia)" />
      <ComboBox fx:id="cmbCuentaDestino" layoutX="200.0" layoutY="150.0" prefWidth="180.0" promptText="Seleccione" />

      <Button fx:id="btnDepositar" layoutX="400.0" layoutY="150.0" mnemonicParsing="false" onAction="#depositar" prefWidth="100.0" text="Depositar" />
      <Button fx:id="btnRetirar" layoutX="510.0" layoutY="150.0" mnemonicParsing="false" onAction="#retirar" prefWidth="100.0" text="Retirar" />
      <Button fx:id="btnTransferir" layoutX="620.0" layoutY="150.0" mnemonicParsing="false" onAction="#transferir" prefWidth="100.0" text="Transferir" />
      <Button fx:id="btnBloquear" layoutX="730.0" layoutY="150.0" mnemonicParsing="false" onAction="#bloquearActivar" prefWidth="140.0" text="Bloquear / Activar" />

      <Button fx:id="btnLimpiar" layoutX="30.0" layoutY="190.0" mnemonicParsing="false" onAction="#limpiarCampos" prefWidth="100.0" text="Limpiar" />

      <!-- Tabla de cuentas -->
      <Label layoutX="30.0" layoutY="230.0" text="Cuentas Registradas" />
      <TableView fx:id="tablaCuentas" layoutX="30.0" layoutY="250.0" prefHeight="220.0" prefWidth="840.0">
        <columns>
          <TableColumn fx:id="colNumero" prefWidth="120.0" text="Número" />
          <TableColumn fx:id="colTitular" prefWidth="180.0" text="Titular" />
          <TableColumn fx:id="colDocumento" prefWidth="130.0" text="Documento" />
          <TableColumn fx:id="colTipo" prefWidth="150.0" text="Tipo" />
          <TableColumn fx:id="colSaldo" prefWidth="120.0" text="Saldo" />
          <TableColumn fx:id="colEstado" prefWidth="130.0" text="Estado" />
        </columns>
      </TableView>

      <!-- Tabla de movimientos -->
      <Label layoutX="30.0" layoutY="485.0" text="Historial de Movimientos" />
      <TableView fx:id="tablaMovimientos" layoutX="30.0" layoutY="505.0" prefHeight="220.0" prefWidth="840.0">
        <columns>
          <TableColumn fx:id="colFecha" prefWidth="150.0" text="Fecha y Hora" />
          <TableColumn fx:id="colCuentaMov" prefWidth="120.0" text="Cuenta" />
          <TableColumn fx:id="colTipoMov" prefWidth="180.0" text="Tipo de Movimiento" />
          <TableColumn fx:id="colMonto" prefWidth="110.0" text="Monto" />
          <TableColumn fx:id="colDescripcion" prefWidth="270.0" text="Descripción" />
        </columns>
      </TableView>

   </children>
</AnchorPane>
